{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for C5h - AI coding tool usage tracker",
  "windows": ["main", "popover"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "autostart:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "positioner:default",
    "positioner:allow-move-window"
  ]
}
